{
  "expo": {
    "name": "DraftRewind",
    "slug": "acadamiv-mobile",
    "version": "1.0.1",
    "owner": "heyobi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.draftrewind.app",
          "bundleIdentifier": "com.draftrewind.app.widgets"
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "DraftRewind, bilgisayarındaki QR kodunu okuyarak giriş yapmak için kamerayı kullanır. / DraftRewind uses the camera to scan the QR code on your computer to sign in.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.draftrewind.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "draftrewind",
              "com.draftrewind.app"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.506965274607-chr5jkmhrpkjo1dtp854tg2oirbs80dk"
            ]
          }
        ],
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "tr"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "buildNumber": "2",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6c5cff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.draftrewind.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3e137a29-0d9d-4133-ba8b-e27af127dd7a"
      }
    },
    "scheme": "draftrewind"
  }
}
